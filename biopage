<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>David Villafán Sánchez</title>
<meta name="description" content="David Villafán Sánchez — portafolio">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#111;
    --paper:#fff;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:"Inter Tight",system-ui,-apple-system,"Helvetica Neue",Arial,sans-serif;
    font-weight:400;
    -webkit-font-smoothing:antialiased;
    overflow:hidden;
  }

  /* ---------- Header ---------- */
  header{
    position:fixed;inset:0 0 auto 0;
    display:flex;justify-content:space-between;align-items:flex-start;
    padding:clamp(20px,3.2vw,44px);
    z-index:5;
  }
  .name{
    font-size:clamp(12px,1.05vw,15px);
    font-weight:500;
    letter-spacing:.16em;
    text-transform:uppercase;
    line-height:1.4;
  }
  .bio-btn{
    font:inherit;
    font-size:clamp(12px,1.05vw,15px);
    font-weight:500;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:var(--ink);
    background:none;border:0;cursor:pointer;
    padding:0 0 4px;
    border-bottom:1px solid transparent;
    transition:border-color .25s;
  }
  .bio-btn:hover,.bio-btn:focus-visible{border-color:var(--ink);outline:none}

  /* ---------- Stage ---------- */
  main{
    height:100%;
    display:flex;align-items:center;justify-content:center;
    padding:80px 16px 40px;
  }

  /* ---------- TV ---------- */
  .tv{
    --w:min(82vw, 960px, 118vh);
    width:var(--w);
    position:relative;
    filter:drop-shadow(0 30px 30px rgba(0,0,0,.18));
  }
  .cabinet{
    position:relative;
    display:grid;
    grid-template-columns:1fr 17%;
    gap:2.2%;
    padding:3.6%;
    border-radius:2.6% / 3.6%;
    background:
      linear-gradient(180deg,rgba(255,255,255,.10),rgba(255,255,255,0) 22%),
      linear-gradient(135deg,#3b3a38 0%,#262524 55%,#1b1a19 100%);
    box-shadow:
      inset 0 2px 0 rgba(255,255,255,.14),
      inset 0 -3px 6px rgba(0,0,0,.5),
      inset 3px 0 6px rgba(255,255,255,.04),
      inset -3px 0 8px rgba(0,0,0,.35);
  }

  /* Bezel + screen */
  .bezel{
    position:relative;
    padding:3.4%;
    border-radius:7% / 9%;
    background:linear-gradient(145deg,#121211,#2a2928);
    box-shadow:
      inset 0 6px 14px rgba(0,0,0,.9),
      inset 0 -1px 0 rgba(255,255,255,.08),
      0 1px 0 rgba(255,255,255,.08);
  }
  .screen{
    position:relative;
    aspect-ratio:4/3;
    border-radius:9% / 11%;
    overflow:hidden;
    background:#000;
    box-shadow:inset 0 0 40px 10px rgba(0,0,0,.9);
    isolation:isolate;
  }
  .screen video,
  .screen canvas{
    position:absolute;inset:0;width:100%;height:100%;
    object-fit:cover;
    display:block;
  }
  .screen video{
    filter:contrast(1.12) saturate(1.2) brightness(1.02) blur(.5px);
    transform:scale(1.02);
  }
  .screen canvas{
    image-rendering:pixelated;
    opacity:0;
    transition:opacity .15s;
    mix-blend-mode:screen;
  }
  .screen.static canvas{opacity:1}

  /* chromatic fringing */
  .fringe{
    position:absolute;inset:0;z-index:2;pointer-events:none;
    background:
      linear-gradient(90deg,rgba(255,0,0,.06),transparent 4%,transparent 96%,rgba(0,60,255,.07));
    mix-blend-mode:screen;
  }
  /* scanlines + phosphor mask */
  .scan{
    position:absolute;inset:0;z-index:3;pointer-events:none;
    background:
      repeating-linear-gradient(0deg,rgba(0,0,0,.34) 0 1px,transparent 1px 3px),
      repeating-linear-gradient(90deg,rgba(255,0,0,.05) 0 1px,rgba(0,255,0,.04) 1px 2px,rgba(0,0,255,.05) 2px 3px);
    animation:flicker .14s infinite;
  }
  /* rolling bar */
  .roll{
    position:absolute;left:0;right:0;height:24%;z-index:3;pointer-events:none;
    background:linear-gradient(180deg,transparent,rgba(255,255,255,.07),transparent);
    animation:roll 7s linear infinite;
  }
  /* curvature / vignette */
  .vignette{
    position:absolute;inset:0;z-index:4;pointer-events:none;
    background:radial-gradient(ellipse at center,transparent 52%,rgba(0,0,0,.55) 100%);
    box-shadow:inset 0 0 60px 14px rgba(0,0,0,.65);
  }
  /* glass reflection */
  .glare{
    position:absolute;z-index:5;pointer-events:none;
    top:4%;left:6%;width:46%;height:30%;
    border-radius:50%;
    background:radial-gradient(ellipse at 30% 30%,rgba(255,255,255,.22),rgba(255,255,255,0) 70%);
    transform:rotate(-14deg);
    filter:blur(6px);
  }
  @keyframes flicker{0%{opacity:.94}50%{opacity:1}100%{opacity:.96}}
  @keyframes roll{from{top:-30%}to{top:110%}}

  /* Control panel */
  .panel{
    display:flex;flex-direction:column;align-items:center;
    justify-content:space-between;
    padding:6% 0 2%;
    gap:6%;
  }
  .knob{
    width:62%;aspect-ratio:1;border-radius:50%;
    background:
      conic-gradient(from 0deg,#9a9a98,#e9e9e6,#8d8d8a,#d8d8d5,#8d8d8a,#e9e9e6,#9a9a98);
    box-shadow:0 3px 6px rgba(0,0,0,.6),inset 0 0 0 3px #3a3937,inset 0 0 0 4px rgba(0,0,0,.6);
    position:relative;
  }
  .knob::after{
    content:"";position:absolute;left:50%;top:9%;width:4%;height:30%;
    background:#222;transform:translateX(-50%);border-radius:2px;
  }
  .knob.b{transform:rotate(48deg)}
  .knob.a{transform:rotate(-30deg)}
  .grille{
    width:78%;flex:1;min-height:30px;
    background:repeating-linear-gradient(180deg,#0e0e0d 0 3px,#2d2c2b 3px 6px);
    border-radius:3px;
    box-shadow:inset 0 1px 3px rgba(0,0,0,.8),0 1px 0 rgba(255,255,255,.08);
  }
  .power{
    display:flex;align-items:center;gap:8%;width:78%;
  }
  .led{
    width:12%;aspect-ratio:1;border-radius:50%;
    background:#ff4a2b;
    box-shadow:0 0 8px 2px rgba(255,74,43,.7);
    animation:pulse 3s ease-in-out infinite;
  }
  .btn{
    flex:1;height:14px;border-radius:2px;
    background:linear-gradient(#bdbdba,#7d7d7a);
    box-shadow:0 2px 3px rgba(0,0,0,.6);
  }
  @keyframes pulse{50%{opacity:.65}}

  /* Brand */
  .brand{
    position:absolute;
    left:5.6%;bottom:.8%;
    font-weight:500;
    font-size:clamp(7px,1.15vw,13px);
    letter-spacing:.42em;
    color:#c9c8c4;
    text-transform:uppercase;
    transform:translateY(-.2em);
  }
  .brand small{
    margin-left:1.4em;letter-spacing:.3em;opacity:.55;font-weight:300;font-size:.78em;
  }

  /* feet */
  .feet{display:flex;justify-content:space-between;padding:0 9%}
  .feet i{
    display:block;width:11%;height:clamp(6px,1vw,12px);
    background:linear-gradient(#1a1a19,#0b0b0b);
    border-radius:0 0 6px 6px;
  }

  /* ---------- Bio overlay ---------- */
  .bio{
    position:fixed;inset:0;z-index:20;
    background:rgba(255,255,255,.96);
    display:flex;align-items:center;justify-content:center;
    padding:32px;
    opacity:0;visibility:hidden;
    transition:opacity .35s,visibility .35s;
  }
  .bio.open{opacity:1;visibility:visible}
  .bio-inner{max-width:520px}
  .bio h2{
    font-weight:300;
    font-size:clamp(26px,4vw,44px);
    letter-spacing:-.01em;
    line-height:1.1;
    margin-bottom:24px;
  }
  .bio p{
    font-weight:300;
    font-size:clamp(14px,1.3vw,17px);
    line-height:1.7;
    color:#333;
    margin-bottom:14px;
  }
  .bio a{color:inherit}
  .close{
    position:absolute;top:clamp(20px,3.2vw,44px);right:clamp(20px,3.2vw,44px);
    font:inherit;font-size:clamp(12px,1.05vw,15px);font-weight:500;
    letter-spacing:.16em;text-transform:uppercase;
    background:none;border:0;cursor:pointer;color:var(--ink);
  }

  /* ---------- Small screens ---------- */
  @media (max-width:640px){
    .tv{--w:94vw}
    .cabinet{grid-template-columns:1fr 14%}
    .panel .grille{display:none}
  }
  @media (prefers-reduced-motion:reduce){
    .scan,.roll,.led{animation:none}
  }
</style>
</head>
<body>

<header>
  <div class="name">David Villafán Sánchez</div>
  <button class="bio-btn" id="bioBtn" aria-haspopup="dialog">Bio</button>
</header>

<main>
  <div class="tv" aria-label="Televisor CRT Hitachi con mis trabajos">
    <div class="cabinet">
      <div class="bezel">
        <div class="screen static" id="screen">
          <video id="video" muted playsinline autoplay preload="auto"></video>
          <canvas id="noise" width="160" height="120"></canvas>
          <div class="fringe"></div>
          <div class="scan"></div>
          <div class="roll"></div>
          <div class="vignette"></div>
          <div class="glare"></div>
        </div>
      </div>

      <div class="panel">
        <div class="knob a"></div>
        <div class="knob b"></div>
        <div class="grille"></div>
        <div class="power"><span class="led"></span><span class="btn"></span></div>
      </div>

      <div class="brand">Hitachi<small>Color</small></div>
    </div>
    <div class="feet"><i></i><i></i></div>
  </div>
</main>

<section class="bio" id="bio" role="dialog" aria-modal="true" aria-label="Bio">
  <button class="close" id="bioClose">Cerrar</button>
  <div class="bio-inner">
    <h2>David Villafán Sánchez</h2>
    <p>Escribe aquí tu bio: quién eres, qué haces y en qué estás trabajando.</p>
    <p>Contacto: <a href="mailto:tucorreo@ejemplo.com">tucorreo@ejemplo.com</a></p>
  </div>
</section>

<script>
  /* ===== EDITA AQUÍ: lista de tus videos (carpeta /videos) ===== */
  const VIDEOS = [
    // "videos/trabajo-01.mp4",
    // "videos/trabajo-02.mp4",
    // "videos/trabajo-03.mp4",
  ];

  const screen = document.getElementById('screen');
  const video  = document.getElementById('video');
  const canvas = document.getElementById('noise');
  const ctx    = canvas.getContext('2d');

  /* Ruido de estática */
  const img = ctx.createImageData(canvas.width, canvas.height);
  function drawNoise(){
    const d = img.data;
    for(let i=0;i<d.length;i+=4){
      const v = Math.random()*255;
      d[i]=d[i+1]=d[i+2]=v; d[i+3]=255;
    }
    ctx.putImageData(img,0,0);
  }
  let last = 0;
  function loop(t){
    if(t-last>55){ drawNoise(); last=t; }
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);

  /* Reproductor en loop con "cambio de canal" */
  let i = 0;
  function play(idx){
    if(!VIDEOS.length){ screen.classList.add('static'); return; }
    screen.classList.add('static');
    video.src = VIDEOS[idx];
    video.loop = VIDEOS.length === 1;
    video.play().catch(()=>{});
  }
  video.addEventListener('playing', ()=> setTimeout(()=>screen.classList.remove('static'), 250));
  video.addEventListener('ended', ()=>{ i = (i+1)%VIDEOS.length; play(i); });
  video.addEventListener('error', ()=>{
    if(VIDEOS.length>1){ i=(i+1)%VIDEOS.length; setTimeout(()=>play(i),600); }
  });
  play(i);

  /* Bio */
  const bio = document.getElementById('bio');
  document.getElementById('bioBtn').onclick   = ()=>bio.classList.add('open');
  document.getElementById('bioClose').onclick = ()=>bio.classList.remove('open');
  addEventListener('keydown', e=>{ if(e.key==='Escape') bio.classList.remove('open'); });
</script>
</body>
</html>
